**/.env*
**/*.p8
**/*.p12
**/*.mobileprovision
**/*.jks
**/*.keystore
/apple-app/ios/
/appletv-app/ios/
/appletv-app/android/
/apple-app/scripts/store-*.mjs
/apple-app/store-metadata.json
/apple-app/release-readiness.json
