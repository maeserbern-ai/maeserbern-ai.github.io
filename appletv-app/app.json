{
  "expo": {
    "name": "Ingredient Dictionary: The Party Game",
    "slug": "ingredient-party-game",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#16211C",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16211C"
    },
    "ios": {
      "bundleIdentifier": "io.github.maeserbern.ingredientpartygame",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "Party Game",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "owner": "maeserbern-ai",
    "extra": {
      "eas": {
        "projectId": "5c765c38-7e1b-4b4c-9f50-5187865a7235"
      }
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "tvosDeploymentTarget": "15.1",
          "appleTVImages": {
            "icon": "./assets/tv/icon-1280x768.png",
            "iconSmall": "./assets/tv/icon-400x240.png",
            "iconSmall2x": "./assets/tv/icon-800x480.png",
            "topShelf": "./assets/tv/topshelf-1920x720.png",
            "topShelf2x": "./assets/tv/topshelf-3840x1440.png",
            "topShelfWide": "./assets/tv/topshelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/tv/topshelf-wide-4640x1440.png"
          }
        }
      ]
    ]
  }
}
