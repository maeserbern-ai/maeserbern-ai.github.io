<?xml version="1.0" encoding="utf-8" ?>
<!-- Ingredient Dictionary The Party Game - the whole game lives in this scene.
     Screens are drawn in code (Screens.brs / Game.brs) at 1920x1080. -->
<component name="MainScene" extends="Scene">
  <interface>
    <!-- Launch parameters from Main(); the game has no deep-linked content, so they are only logged. -->
    <field id="launchArgs" type="assocarray" onChange="onLaunchArgs" />
    <!-- Set when Back is pressed on the title screen; Main() then exits the channel. -->
    <field id="exitRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/Kit.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <script type="text/brightscript" uri="pkg:/components/Screens.brs" />
  <script type="text/brightscript" uri="pkg:/components/Game.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x16211CFF" />
    <Poster id="glow" uri="pkg:/images/ui/glow.png" translation="[960,0]" width="960" height="540" />
    <Group id="screenLayer" />
    <Group id="modalLayer" />

    <!-- Big CORRECT! / WRONG! stamp -->
    <Group id="pop" visible="false">
      <Rectangle id="popDim" width="1920" height="1080" color="0x3C08068C" />
      <Group id="popStamp" translation="[960,440]" rotation="-0.1047">
        <Poster id="popEdge" uri="pkg:/images/ui/pill.9.png" blendColor="0xFFFFFFE6" />
        <Poster id="popBox" uri="pkg:/images/ui/pill.9.png" blendColor="0xE06A5FFF" />
        <Label id="popTitle" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
          <Font role="font" uri="pkg:/fonts/Fraunces-Black.ttf" size="260" />
        </Label>
      </Group>
      <Label id="popSub" translation="[0,760]" width="1920" height="80" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="pkg:/fonts/Inter-ExtraBold.ttf" size="52" />
      </Label>
    </Group>
    <Animation id="popAnim" duration="0.45" easeFunction="outCubic" repeat="false">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[2.4, 2.4], [1.0, 1.0]]" fieldToInterp="popStamp.scale" />
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="popStamp.opacity" />
    </Animation>

    <Group id="confettiLayer" />
    <Timer id="beat" duration="0.1" repeat="true" />
    <Timer id="confTimer" duration="0.033" repeat="true" />
  </children>
</component>
